# Klovy Chat backend — local development
# Copy: cp .env.example .env
# Then: cargo run
#
# NODE_ENV=development skips production checks (HTTPS, Turnstile, ClamAV).
# Do not use these keys anywhere except your machine.

# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
INTERNAL_HTTP_PORT=8082
TRUST_PROXY=false
TRUSTED_IPS=

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/app?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
DB_NAME=app

# --- Auth / crypto (local only — generate your own before any shared deploy) ---
JWT_KEY=local-dev-jwt-key-change-me-32chars-min
FIELD_ENCRYPTION_KEY=local-dev-field-key-change-me-32ch
TOKEN_HASH_KEY=local-dev-token-hash-key-change-me-32

# --- URLs / CORS ---
ORIGIN=http://127.0.0.1:5173
# Production may contain comma-separated origins. For Capacitor also allow
# http://localhost (Android) and capacitor://localhost (iOS), without wildcards.
FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:8080
PUBLIC_WS_URL=ws://127.0.0.1:8080/ws
PUBLIC_WEBSITE_URL=http://127.0.0.1:3000

# --- Internal proxy ---
INTERNAL_PROXY_SECRET=local-dev-internal-proxy-secret-32

# --- Cloudflare Turnstile (empty = bypass in development) ---
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Registration ---
REGISTRATION_DISABLED=false
SIGNUP_MAX_PER_IP_HOUR=10
SIGNUP_MAX_GLOBAL_PER_HOUR=200
SIGNUP_MAX_GLOBAL_PER_DAY=1000
PWNED_PASSWORD_CHECK_ENABLED=false

# --- WebSocket (required in production; off is easier for local API/WS work) ---
WS_FRAME_ENCRYPTION=false

# --- Cloudflare R2 / CDN ---
# Non-empty values let the process start. Uploads need a real R2 account.
# Dummy IDs do not talk to Cloudflare until you upload a file.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=local-dev-access-key
R2_SECRET_ACCESS_KEY=local-dev-secret-key-not-for-production
R2_PUBLIC_BUCKET=klovy-public
R2_QUARANTINE_BUCKET=klovy-quarantine
CDN_PUBLIC_BASE_URL=http://127.0.0.1:8080
USER_STORAGE_QUOTA_BYTES=104857600

# Optional local scanner: docker compose --profile scan up -d
# CLAMAV_HOST=127.0.0.1:3310
CLAMAV_HOST=

# --- LiveKit (empty = voice disabled) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_NAME=

# --- Giphy (empty = GIFs/stickers disabled) ---
GIPHY_API_KEY=

# --- Security ---
SECURITY_REPORT_SECRET=local-dev-security-report-16
